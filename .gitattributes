# Normalize line endings on commit; binary files are left untouched.
* text=auto

*.cs text
*.csproj text
*.sln text
*.md text
*.json text
*.yml text
*.yaml text
*.asset text
*.unity text
*.prefab text
*.mat text
*.anim text
*.controller text
*.meta text
*.shader text
*.cginc text

*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary
*.exe binary
*.pdb binary
*.resS binary
*.assets binary
*.resource binary
*.bundle binary
*.unitypackage binary

